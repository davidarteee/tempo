# ─── Supabase (obligatori per a comptes i sincronització) ───────────────────
# Sense aquestes dues variables, Tempo funciona en "mode local" (només aquest navegador).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # o la clau "anon" antiga
# Només servidor (rutes /api: Google Calendar i notificacions push). MAI amb prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx                          # o SUPABASE_SERVICE_ROLE_KEY

# ─── URL pública de l'aplicació ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://el-teu-domini.vercel.app

# ─── Google Calendar (opcional) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_STATE_SECRET=una-cadena-aleatoria-llarga             # signa l'estat d'OAuth

# ─── Notificacions push (opcional) ──────────────────────────────────────────
# Genera-les amb: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@example.com
# Protegeix /api/cron/reminders
CRON_SECRET=una-altra-cadena-aleatoria-llarga
